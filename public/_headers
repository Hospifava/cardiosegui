# Encabezados de seguridad básicos para todas las páginas de CardioSegui.
# Netlify lee este archivo al publicar (también con Netlify Drop) y no lo muestra como página.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# El service worker nunca se guarda en caché del navegador:
# así los celulares detectan enseguida cuando hay una versión nueva de la app.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
